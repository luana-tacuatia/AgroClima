# WeatherAPI.com
WEATHER_API_KEY=

# Supabase usado somente no servidor (Settings > API Keys no painel do Supabase)
# URL do projeto, ex.: https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Chave secreta nova (sb_secret_...). Também aceita a chave clássica em SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Identificação pública da aplicação
NEXT_PUBLIC_APP_NAME=AgroClima